# Postgres (compose uses these defaults)
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=insightflow
POSTGRES_DB=insightflow

# API
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@db:5432/insightflow
# Generate a strong secret (32+ bytes), e.g. `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me-to-a-32-byte-random-string
ENVIRONMENT=development

# LLM provider (default anthropic; set LLM_PROVIDER=openai to swap)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
